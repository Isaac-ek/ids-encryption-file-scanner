# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WORKER_TOKEN=replace-with-another-random-secret-of-at-least-32-characters
SECURITY_DATA_DIR=/app/.runtime
IDS_MODEL_DIR=/app/models2
# Explicit hostnames you own or have permission to assess. Empty disables website scans.
SCAN_ALLOWED_HOSTS=
SCAN_ALLOW_LOCALHOST=false
IDS_AUTO_ENCRYPT=false

# Vercel requires a pooled PostgreSQL connection and database-backed encrypted files.
# Local/container deployments default to local storage.
# DATABASE_URL=postgresql://...
FILE_STORAGE_BACKEND=local
# For database file storage only: base64.urlsafe_b64encode(os.urandom(32)).decode()
# Keep this stable and back it up separately; changing it makes existing files unreadable.
# KEY_ENCRYPTION_KEY=

# Password recovery: install/connect Resend to the intended Vercel environments.
# RESEND_API_KEY=
# RESEND_EMAIL_DOMAIN=your-verified-sending-domain.example
# Explicit trusted app origin (Preview defaults to VERCEL_URL; never request headers).
# PASSWORD_RESET_ORIGIN=https://your-app.example
# Optional recovery email when provisioning a customer administrator.
# BOOTSTRAP_EMAIL=owner@example.com
